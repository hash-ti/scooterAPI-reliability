{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(scooter_api/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(*.md)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/Scripts/python -m scooter_api.cli:*)",
      "Bash(.venv/bin/python -m scooter_api.cli:*)",
      "Bash(.venv/Scripts/python app.py)",
      "Bash(.venv/bin/python app.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree list)",
      "mcp__scooter-ops"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree add:*)",
      "Bash(pip install:*)",
      "Bash(* -m pip install:*)",
      "Edit(requirements.txt)",
      "Edit(scooter_db.json)",
      "Edit(.mcp.json)",
      "Edit(scripts/**)",
      "Edit(app.py)",
      "Edit(mcp_server.py)"
    ],
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm var/*)",
      "Bash(* --including-default-db*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(heroku:*)",
      "Bash(sudo:*)",
      "WebFetch"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["scooter-ops"],
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  }
}
